{
  "name": "the-market-whisperer",
  "version": "1.0.0",
  "description": "News and Policy-Aware Trading Platform with Quant Engine",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "setup:python": "cd quant-engine && pip install -r requirements.txt",
    "download:models": "cd quant-engine && python download_models.py"
  },
  "keywords": [
    "trading",
    "finance",
    "quantitative",
    "sentiment-analysis"
  ],
  "author": "Trading Platform Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "mongodb": "^7.0.0"
  }
}
